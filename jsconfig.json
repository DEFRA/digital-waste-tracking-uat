{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": ["jest.config.js", ".prettierrc.js", ".eslintrc.cjs", "test/**/*.js"]
}
