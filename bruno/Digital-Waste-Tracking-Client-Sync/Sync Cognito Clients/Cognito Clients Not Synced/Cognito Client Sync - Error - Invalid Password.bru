meta {
  name: Cognito Client Sync - Error - Invalid Password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clients/sync
  body: none
  auth: basic
}

headers {
  x-api-key: {{cdp-api-key}}
}

auth:basic {
  username: waste-movement-external-api
  password: invalid-password
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
