meta {
  name: Rotate Cognito Client Secret
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/clients/{{tenantServiceName}}/{{clientId}}/rotate
  body: none
  auth: inherit
}

headers {
  x-api-key: {{cdp-api-key}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
