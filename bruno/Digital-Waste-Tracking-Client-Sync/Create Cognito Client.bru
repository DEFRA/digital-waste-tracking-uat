meta {
  name: Create Cognito Client
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/clients/{{tenantServiceName}}
  body: json
  auth: inherit
}

headers {
  x-api-key: {{cdp-api-key}}
  Content-Type: application/json
}

body:json {
  {
    "clientName": "Cognito_Test_User_01"
  }
}

vars:post-response {
  clientId: res.body.clientId
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
