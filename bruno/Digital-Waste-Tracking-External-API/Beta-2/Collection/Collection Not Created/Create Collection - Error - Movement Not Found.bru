meta {
  name: Create Collection - Error - Movement Not Found
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/beta-2/movements/00NOTFND/collection
  body: json
  auth: inherit
}

headers {
  x-api-code: {{apiCode}}
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {}
}

script:pre-request {
  const now = new Date();
  // now.setFullYear(now.getFullYear() + 1); // Adds one year to the current date
  // now.setFullYear(now.getFullYear() - 1); // Removes one year from the current date
  bru.setVar('timestamp', now.toISOString());
}

tests {
  test("status is 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
  test("content type includes application/problem+json", function () {
    expect(res.getHeader("content-type")).to.include("application/problem+json");
  });
  test("movement is not found", function () {
    expect(res.body.detail).to.equal("movementId not found");
  });
}
