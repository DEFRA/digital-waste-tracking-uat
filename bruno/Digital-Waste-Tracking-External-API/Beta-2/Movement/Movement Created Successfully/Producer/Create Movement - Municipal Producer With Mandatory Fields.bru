meta {
  name: Create Movement - Municipal Producer With Mandatory Fields
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/beta-2/movements
  body: json
  auth: inherit
}

headers {
  x-api-code: {{apiCode}}
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {
    "producer": {
      "wasteSource": "Municipal",
      "organisationName": "Test Council",
      "authorisationNumber": "EAS/P/123456",
      "address": {
        "postcode": "TE1 5CD"
      },
      "contactDetails": {
        "emailAddress": "waste.services@example.gov.uk"
      }
    }
  }
}

script:pre-request {
  const now = new Date();
  // now.setFullYear(now.getFullYear() + 1); // Adds one year to the current date
  // now.setFullYear(now.getFullYear() - 1); // Removes one year from the current date
  bru.setVar('timestamp', now.toISOString());
}

script:post-response {
  const movementId = res.body.data.movementId;
  bru.setVar('movementId', movementId);

  const movementIds = Object.assign([], bru.getVar('movementIds') || []);
  movementIds.push(movementId);
  bru.setVar('movementIds', movementIds);
}
