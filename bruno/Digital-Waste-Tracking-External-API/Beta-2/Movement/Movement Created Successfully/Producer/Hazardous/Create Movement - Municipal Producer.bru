meta {
  name: Create Movement - Municipal Producer
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/beta-2/movements
  body: json
  auth: inherit
}

headers {
  x-api-code: {{apiCode}}
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

