meta {
  name: Create Movement - Intended Carriers More Than One
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/beta-2/movements
  body: json
  auth: inherit
}

headers {
  x-api-code: {{apiCode}}
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

