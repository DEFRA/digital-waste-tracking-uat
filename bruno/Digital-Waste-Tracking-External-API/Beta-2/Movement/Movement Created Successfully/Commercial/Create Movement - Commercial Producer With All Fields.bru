meta {
  name: Create Movement - Commercial Producer With All Fields
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/beta-2/movements
  body: json
  auth: inherit
}

headers {
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {
    "apiCode": "{{apiCode}}",
    "producer": {
      "wasteSource": "Commercial",
      "organisationName": "ACME Waste Producers Ltd",
      "authorisationNumber": "EAS/P/123456",
      "sicCode": "38110",
      "address": {
        "fullAddress": "10 Industrial Way, Test City",
        "postcode": "TE1 2PQ"
      },
      "contactDetails": {
        "emailAddress": "producer@example.com",
        "phoneNumber": "01234567890"
      }
    },
    "brokerOrDealer": {
      "isPresent": true,
      "items": [
        {
          "organisationName": "Broker Demo Ltd",
          "registrationNumber": "CBDU654321",
          "contactDetails": {
            "emailAddress": "broker@example.com"
          },
          "address": {
            "fullAddress": "2 Broker Yard, Test City",
            "postcode": "TE1 1ST"
          }
        }
      ]
    },
    "supportingReferences": [
      {
        "label": "PO Number",
        "reference": "PO-48213"
      },
      {
        "label": "Job Number",
        "reference": "JB-9931"
      },
      {
        "label": "Weighbridge Number",
        "reference": "WB-9931"
      }
    ],
    "specialHandlingRequirements": "Handle with care and keep upright."
  }
}

script:pre-request {
  const now = new Date();
  // now.setFullYear(now.getFullYear() + 1); // Adds one year to the current date
  // now.setFullYear(now.getFullYear() - 1); // Removes one year from the current date
  bru.setVar('timestamp', now.toISOString());
}

script:post-response {
  const movementId = res.body.data.movementId;
  bru.setVar('movementId', movementId);

  const movementIds = Object.assign([], bru.getVar('movementIds') || []);
  movementIds.push(movementId);
  bru.setVar('movementIds', movementIds);
}

tests {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("content type includes application/json", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
  });
  test("a movement id is returned", function () {
    expect(res.body.data.movementId).to.be.a("string").and.not.empty;
  });
}
