meta {
  name: Create Movement - Error - Invalid API Code
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/beta-2/movements
  body: json
  auth: inherit
}

headers {
  x-api-code: 401dd617-58c4-4c71-bf59-db04ad588c3d
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {
    "producer": {
      "wasteSource": "HOUSEHOLD"
    },
    "collectionDateTime": "2026-01-15T09:30:00Z",
    "collectionSite": {
      "address": {
        "fullAddress": "10 Industrial Way, Test City",
        "postcode": "TE1 2PQ"
      },
      "contactDetails": {
        "emailAddress": "site@example.com",
        "phoneNumber": "01234567890"
      }
    },
    "intendedCarriers": [
      {
        "organisationName": "Carrier Demo Ltd",
        "registrationNumber": "CBDU123456",
        "meansOfTransport": "ROAD",
        "vehicleRegistration": "AB12 CDE",
        "contactDetails": {
          "emailAddress": "carrier@example.com",
          "phoneNumber": "01234567890"
        }
      }
    ],
    "intendedReceivers": [
      {
        "siteName": "Receiver Site Ltd",
