meta {
  name: Create Movement - Error - Broker Or Dealer Registration Number And Reason
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/beta-2/movements
  body: json
  auth: inherit
}

headers {
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {
    "apiCode": "{{apiCode}}",
    "producer": {
      "wasteSource": "Household"
    },
    "brokerOrDealer": {
      "isPresent": true,
      "items": [
        {
          "organisationName": "Broker Demo Ltd",
          "registrationNumber": "CBDU654321",
          "contactDetails": {
            "emailAddress": "broker@example.com"
          },
          "address": {
            "fullAddress": "2 Broker Yard, Test City",
            "postcode": "TE1 1ST"
          },
          "reasonForNoRegistrationNumber": "One-off arrangement"
        }
      ]
    }
  }
}

script:pre-request {
  const now = new Date();
  // now.setFullYear(now.getFullYear() + 1); // Adds one year to the current date
  // now.setFullYear(now.getFullYear() - 1); // Removes one year from the current date
  bru.setVar('timestamp', now.toISOString());
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("content type includes application/problem+json", function () {
    expect(res.getHeader("content-type")).to.include("application/problem+json");
  });
  test("registration number is not allowed with a reason", function () {
    const errors = res.body.errors || [];
    const found = errors.some(function (error) {
      return error.pointer === "/brokerOrDealer/items/0/registrationNumber" && error.errorType === "NotAllowed";
    });
    expect(found).to.equal(true);
  });
  test("a reason is not allowed with a registration number", function () {
    const errors = res.body.errors || [];
    const found = errors.some(function (error) {
      return error.pointer === "/brokerOrDealer/items/0/reasonForNoRegistrationNumber" && error.errorType === "NotAllowed";
    });
    expect(found).to.equal(true);
  });
}
