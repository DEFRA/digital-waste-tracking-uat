meta {
  name: Create Movement - Error - Missing required field
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/beta-2/movements
  body: json
  auth: inherit
}

headers {
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {}
}

script:pre-request {
  const now = new Date();
  // now.setFullYear(now.getFullYear() + 1); // Adds one year to the current date
  // now.setFullYear(now.getFullYear() - 1); // Removes one year from the current date
  bru.setVar('timestamp', now.toISOString());
}
tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("content type includes application/problem+json", function () {
    expect(res.getHeader("content-type")).to.include("application/problem+json");
  });
  test("apiCode is required", function () {
    const errors = res.body.errors || [];
    const found = errors.some(function (error) {
      return error.pointer === "/apiCode" && error.errorType === "NotProvided";
    });
    expect(found).to.equal(true);
  });
  test("producer is required", function () {
    const errors = res.body.errors || [];
    const found = errors.some(function (error) {
      return error.pointer === "/producer" && error.errorType === "NotProvided";
    });
    expect(found).to.equal(true);
  });
}
