meta {
  name: Create Movement - Error - Commercial Missing Authorisation Number And Reason
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/beta-2/movements
  body: json
  auth: inherit
}

headers {
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {
    "apiCode": "{{apiCode}}",
    "producer": {
      "wasteSource": "Commercial",
      "organisationName": "ACME Waste Producers Ltd",
      "sicCode": "38110",
      "address": {
        "fullAddress": "10 Industrial Way, Test City",
        "postcode": "TE1 2PQ"
      },
      "contactDetails": {
        "emailAddress": "producer@example.com"
      }
    }
  }
}

script:pre-request {
  const now = new Date();
  // now.setFullYear(now.getFullYear() + 1); // Adds one year to the current date
  // now.setFullYear(now.getFullYear() - 1); // Removes one year from the current date
  bru.setVar('timestamp', now.toISOString());
}
tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("content type includes application/problem+json", function () {
    expect(res.getHeader("content-type")).to.include("application/problem+json");
  });
  test("authorisation number is required", function () {
    const errors = res.body.errors || [];
    const found = errors.some(function (error) {
      return error.pointer === "/producer/authorisationNumber" && error.errorType === "NotProvided";
    });
    expect(found).to.equal(true);
  });
  test("a reason is required", function () {
    const errors = res.body.errors || [];
    const found = errors.some(function (error) {
      return error.pointer === "/producer/reasonForNoAuthorisationNumber" && error.errorType === "NotProvided";
    });
    expect(found).to.equal(true);
  });
}
