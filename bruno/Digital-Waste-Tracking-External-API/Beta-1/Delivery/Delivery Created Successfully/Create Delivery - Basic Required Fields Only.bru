meta {
  name: Create Delivery - Basic Required Fields Only
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/beta-1/deliveries
  body: json
  auth: inherit
}

headers {
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {
    "apiCode": "{{apiCode}}",
    "movementIds": {{movementIds}}
  }
}

vars:pre-request {
  ~movementIds: ["xxxx", "yyyy"]
}

vars:post-response {
  deliveryId: res.body.data.deliveries[0].deliveryId
}

script:pre-request {
  const now = new Date();
  // now.setFullYear(now.getFullYear() + 1); // Adds one year to the current date
  // now.setFullYear(now.getFullYear() - 1); // Removes one year from the current date
  bru.setVar('timestamp', now.toISOString());
}

script:post-response {
  bru.deleteVar('movementIds');
}
