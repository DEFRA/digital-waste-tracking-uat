meta {
  name: 05 Invalid JSON
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/beta-1/movements
  body: text
  auth: inherit
}

headers {
  Content-Type: application/json
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:text {
{
}

docs {
  400 Bad Request. The content type says JSON, and the body is not valid JSON.

  `detail` is `Invalid request payload JSON format`. There is no `errors` array, because the body never reached schema validation.
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("invalid JSON has no errors array", function() {
    expect(res.body.detail).to.equal("Invalid request payload JSON format");
    expect(res.body.errors).to.equal(undefined);
  });
}
