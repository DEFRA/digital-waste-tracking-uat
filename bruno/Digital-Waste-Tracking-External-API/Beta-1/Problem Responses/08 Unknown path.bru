meta {
  name: 08 Unknown path
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/beta-1/does-not-exist
  body: none
  auth: inherit
}

headers {
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

docs {
  404 Not Found. The path is not a beta-1 route.

  `detail` is `Not Found`. Instance is `/beta-1/does-not-exist`.

  Type: https://defra.github.io/digital-waste-tracking-api-docs/preview/problems/not-found
}

tests {
  test("status is 404", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("unknown path is not found", function() {
    expect(res.body.title).to.equal("Not Found");
    expect(res.body.detail).to.equal("Not Found");
    expect(res.body.instance).to.equal("/beta-1/does-not-exist");
  });
}
