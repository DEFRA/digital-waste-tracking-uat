meta {
  name: 02 Unexpected field
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/beta-1/movements
  body: json
  auth: inherit
}

headers {
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {
    "apiCode": "{{apiCode}}",
    "orgName": "not-allowed"
  }
}

docs {
  400 Bad Request. `orgName` is not in the schema.

  `errors` has one item: `must NOT have additional properties`, pointer `/orgName`, errorType `NotAllowed`.
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("unexpected field is not allowed", function() {
    expect(res.body.errors[0].errorType).to.equal("NotAllowed");
    expect(res.body.errors[0].pointer).to.equal("/orgName");
  });
}
