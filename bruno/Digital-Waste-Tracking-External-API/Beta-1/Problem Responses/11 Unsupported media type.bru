meta {
  name: 11 Unsupported media type
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/beta-1/movements
  body: text
  auth: inherit
}

headers {
  Content-Type: application/xml
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:text {
<movement/>
}

docs {
  415 Unsupported Media Type. The body is XML.

  `title` and `detail` are both `Unsupported Media Type`. There is no `errors` array.

  Type: https://defra.github.io/digital-waste-tracking-api-docs/preview/problems/unsupported-media-type
}

tests {
  test("status is 415", function() {
    expect(res.getStatus()).to.equal(415);
  });

  test("xml is unsupported", function() {
    expect(res.body.title).to.equal("Unsupported Media Type");
    expect(res.body.detail).to.equal("Unsupported Media Type");
  });
}
