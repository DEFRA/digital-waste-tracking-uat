  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {
    "apiCode": "{{apiCode}}"
  }
}

docs {
  404 Not Found. No delivery exists with id `00NOTFND`.

  `detail` is `No delivery exists with delivery ID: 00NOTFND`. Instance is `/beta-1/deliveries/00NOTFND/receipt`.
}

tests {
  test("status is 404", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("receipt delivery is not found", function() {
    expect(res.body.detail).to.equal("No delivery exists with delivery ID: 00NOTFND");
  });
}
