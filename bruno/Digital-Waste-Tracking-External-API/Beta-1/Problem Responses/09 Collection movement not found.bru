docs {
  404 Not Found. No movement exists with id `00NOTFND`.

  `detail` is `movementId not found`. Instance is `/beta-1/movements/00NOTFND/collection`.
}

tests {
  test("status is 404", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("collection movement is not found", function() {
