meta {
  name: 06 Unrecognised API code
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/beta-1/movements
  body: json
  auth: inherit
}

headers {
  ~x-cdp-request-id: {{$randomUUID}}
  ~Authorization: {{ManuallyObtainedAccessToken}}
}

body:json {
  {
    "apiCode": "401dd617-58c4-4c71-bf59-db04ad588c3d"
  }
}

docs {
  400 Bad Request. `apiCode` is a UUID, and that code is not recognised.

  `detail` is `the API Code supplied is invalid`. There is no `errors` array. This is a lookup failure, not a schema failure.
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("unrecognised code has no errors array", function() {
    expect(res.body.detail).to.equal("the API Code supplied is invalid");
    expect(res.body.errors).to.equal(undefined);
  });
}
